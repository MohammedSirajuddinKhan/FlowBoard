<!DOCTYPE html>
<html lang="en">
<head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>FlowBoard</title>
      <link rel="icon" type="image/x-icon" href="/favicon.svg" />
      <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <main>
      

      <section>
        <form class="auth-form-login" id="loginForm">
          <h2>Login to FlowBoard</h2>

          <div id="errorContainer"></div>

          <div class="form-group">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
            />
          </div>

          <div class="form-group" style="margin-bottom: 2vh;">
            <label for="password">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••"
            />
          </div>

          <button type="submit">Login</button>

          <div class="auth-link" style="padding-bottom: 3vh;padding-top: 2vh;">
            Don't have an account? <a href="/register">Register here</a>
          </div>
        </form>
      </section>
    </main>
    <script>
      const form = document.getElementById("loginForm");
      const errorContainer = document.getElementById("errorContainer");
      const redirectTo = new URLSearchParams(window.location.search).get(
        "redirectTo",
      );
      const registerLink = document.querySelector(".auth-link a");

      if (registerLink) {
        registerLink.href = redirectTo
          ? `/register?redirectTo=${encodeURIComponent(redirectTo)}`
          : "/register";
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorContainer.innerHTML = "";

        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;

        try {
          if (window.Loader && typeof window.Loader.show === 'function') window.Loader.show();
          const response = await fetch("/api/auth/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password }),
          });

          const data = await response.json();

          if (!response.ok) {
            if (window.Loader && typeof window.Loader.hide === 'function') window.Loader.hide();
            errorContainer.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
            return;
          }

          // ensure loader remains visible for a short moment to avoid flicker
          if (window.Loader && typeof window.Loader.hide === 'function') {
            setTimeout(() => window.Loader.hide(), 160);
          }
          window.location.href = redirectTo || "/";
        } catch (error) {
          console.error("Login error:", error);
          if (window.Loader && typeof window.Loader.hide === 'function') window.Loader.hide();
          errorContainer.innerHTML =
            '<div class="alert alert-error">An error occurred. Please try again.</div>';
        }
      });
    </script>
  </body>
</html>
