<!DOCTYPE html>
<html lang="en">

<head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>FlowBoard</title>
      <link rel="icon" type="image/x-icon" href="/favicon.svg" />
      <link rel="stylesheet" href="style.css">
    </head>
  <body>
    <main>
      

      <section>
        <form class="auth-form" id="registerForm">
          <h2>Create Account</h2>

          <div id="errorContainer"></div>

          <div class="form-group">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
            />
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••"
              minlength="6"
            />
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              placeholder="••••••"
              minlength="6"
            />
          </div>

          <button type="submit">Register</button>

          <div class="auth-link">
            Already have an account? <a href="/login">Login here</a>
          </div>
        </form>
      </section>
    </main>

    <script>
      const form = document.getElementById("registerForm");
      const errorContainer = document.getElementById("errorContainer");
      const redirectTo = new URLSearchParams(window.location.search).get(
        "redirectTo",
      );
      const loginLink = document.querySelector(".auth-link a");

      if (loginLink) {
        loginLink.href = redirectTo
          ? `/login?redirectTo=${encodeURIComponent(redirectTo)}`
          : "/login";
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorContainer.innerHTML = "";

        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;
        const confirmPassword =
          document.getElementById("confirmPassword").value;

        try {
          if (window.Loader && typeof window.Loader.show === 'function') window.Loader.show();
          const response = await fetch("/api/auth/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password, confirmPassword }),
          });

          const data = await response.json();

          if (!response.ok) {
            if (window.Loader && typeof window.Loader.hide === 'function') window.Loader.hide();
            errorContainer.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
            return;
          }

          if (window.Loader && typeof window.Loader.hide === 'function') {
            setTimeout(() => window.Loader.hide(), 160);
          }
          window.location.href = redirectTo || "/";
        } catch (error) {
          console.error("Register error:", error);
          if (window.Loader && typeof window.Loader.hide === 'function') window.Loader.hide();
          errorContainer.innerHTML =
            '<div class="alert alert-error">An error occurred. Please try again.</div>';
        }
      });
    </script>
  </body>
</html>
