<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>FlowBoard - Register</title>
    <style>
      body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }

      main {
        height: auto;
        width: 100%;
        max-width: 400px;
        padding: 2rem;
      }

      nav {
        margin-bottom: 2rem;
        text-align: center;
      }

      section {
        padding: 0;
        flex-direction: column;
      }

      .auth-form {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .auth-form h2 {
        margin-bottom: 1rem;
        font-size: 1.5rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .form-group label {
        font-size: 0.9rem;
        color: var(--primary-text-color);
      }

      .form-group input {
        padding: var(--padding-m) var(--padding-l);
        background-color: var(--bg-task-color);
        border: 1px solid #444;
        border-radius: var(--border-radius-m);
        color: var(--primary-text-color);
        font-size: 1rem;
      }

      .form-group input:focus {
        outline: none;
        border-color: #666;
        background-color: #333;
      }

      .auth-form button {
        padding: var(--padding-m) var(--padding-l);
        background-color: var(--bg-btn-clr);
        border: 1px solid #444;
        border-radius: var(--border-radius-m);
        color: var(--primary-text-color);
        cursor: pointer;
        font-size: 1rem;
        transition: all 0.3s ease;
      }

      .auth-form button:hover {
        background-color: #333;
        border-color: #666;
      }

      .auth-link {
        text-align: center;
        font-size: 0.9rem;
        color: #888;
      }

      .auth-link a {
        color: #bbb;
        text-decoration: none;
      }

      .auth-link a:hover {
        text-decoration: underline;
      }

      .alert {
        padding: var(--padding-l);
        border-radius: var(--border-radius-m);
        margin-bottom: 1rem;
        font-size: 0.9rem;
      }

      .alert-error {
        background-color: #3a1a1a;
        color: #ff6b6b;
        border: 1px solid #662222;
      }
    </style>
  </head>
  <body>
    <main>
      <nav>
        <div class="left" style="font-size: 1.5rem; margin: 0">FlowBoard</div>
      </nav>

      <section>
        <form class="auth-form" id="registerForm">
          <h2>Create Account</h2>

          <div id="errorContainer"></div>

          <div class="form-group">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
            />
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••"
              minlength="6"
            />
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              placeholder="••••••"
              minlength="6"
            />
          </div>

          <button type="submit">Register</button>

          <div class="auth-link">
            Already have an account? <a href="/login">Login here</a>
          </div>
        </form>
      </section>
    </main>

    <script>
      const form = document.getElementById("registerForm");
      const errorContainer = document.getElementById("errorContainer");
      const redirectTo = new URLSearchParams(window.location.search).get(
        "redirectTo",
      );
      const loginLink = document.querySelector(".auth-link a");

      if (loginLink) {
        loginLink.href = redirectTo
          ? `/login?redirectTo=${encodeURIComponent(redirectTo)}`
          : "/login";
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorContainer.innerHTML = "";

        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;
        const confirmPassword =
          document.getElementById("confirmPassword").value;

        try {
          const response = await fetch("/api/auth/register", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password, confirmPassword }),
          });

          const data = await response.json();

          if (!response.ok) {
            errorContainer.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
            return;
          }

          window.location.href = redirectTo || "/";
        } catch (error) {
          console.error("Register error:", error);
          errorContainer.innerHTML =
            '<div class="alert alert-error">An error occurred. Please try again.</div>';
        }
      });
    </script>
  </body>
</html>
